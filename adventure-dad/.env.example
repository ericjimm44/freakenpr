# ─── Adventure Dad — environment ────────────────────────────────────────────
# The app runs fully WITHOUT any of these (local persistence + offline AI engine).
# Add them to light up the production integrations.

# OpenAI — powers the AI Mission Architect, recaps & Family Lore Engine.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Supabase — Postgres + Storage + Realtime (see /supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk — authentication.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Mapbox — Adventure Atlas.
NEXT_PUBLIC_MAPBOX_TOKEN=
